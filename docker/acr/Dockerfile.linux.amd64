FROM ghcr.io/rapidfort/kimia:1.0.26@sha256:7db5d434e54f343963abec53e59c2cf8e73f02f0521784564b66f4e54ea7cf60

ARG PLUGIN_VERSION=dev
ARG PLUGIN_REVISION=unknown
ARG PLUGIN_CREATED=

ENV KIMIA_VERSION=1.0.26

LABEL org.opencontainers.image.title="drone-kimia-acr" \
      org.opencontainers.image.description="Harness/Drone adapter for RapidFort Kimia using Azure Container Registry authentication" \
      org.opencontainers.image.source="https://github.com/harness-community/drone-kimia" \
      org.opencontainers.image.url="https://github.com/harness-community/drone-kimia" \
      org.opencontainers.image.documentation="https://github.com/harness-community/drone-kimia#readme" \
      org.opencontainers.image.vendor="Harness Community" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${PLUGIN_VERSION}" \
      org.opencontainers.image.revision="${PLUGIN_REVISION}" \
      org.opencontainers.image.created="${PLUGIN_CREATED}" \
      org.opencontainers.image.base.name="ghcr.io/rapidfort/kimia:1.0.26" \
      org.opencontainers.image.base.digest="sha256:7db5d434e54f343963abec53e59c2cf8e73f02f0521784564b66f4e54ea7cf60"

COPY release/linux/amd64/kimia-acr /usr/local/bin/kimia-acr

RUN test "$(id -u):$(id -g)" = "1000:1000" \
    && test "${HOME}" = "/home/kimia" \
    && test "$(pwd)" = "/home/kimia" \
    && /usr/local/bin/kimia-acr --version \
    && /usr/local/bin/kimia-acr --help | grep -q "PLUGIN_EXPAND_TAG" \
    && /usr/local/bin/kimia-acr --help | grep -q "SERVICE_PRINCIPAL_CLIENT_ID" \
    && buildkitd --version \
    && rootlesskit --version

ENTRYPOINT ["/usr/local/bin/kimia-acr"]
CMD []
